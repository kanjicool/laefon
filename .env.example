# คัดลอกเป็น .env แล้วแก้ตามเครื่อง
# nginx: ค่าเริ่มต้นแบบ tent คือ 127.0.0.1:80 (เปิดเฉพาะเครื่องตัวเอง)
NGINX_HOST=127.0.0.1
# เครื่องที่ port 80 ไม่ว่าง (เช่นมี apache2) ใช้ 8080
NGINX_PORT=80

# dev (docker-compose.dev.yml)
API_PORT=9001
WEB_DEV_PORT=5173

# backend
APP_ENV=prod
MOCK_LIVE_CLOCK=true
